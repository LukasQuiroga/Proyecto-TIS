# PostgreSQL en la nube (Neon)
#
# Crea el proyecto en https://neon.tech, copia el "connection string"
# y rellena estos valores en tu .env (DB_HOST, DB_PASSWORD y DB_USER).
#
# Ejemplo de connection string de Neon:
#   postgres://usuario:CONTRASENA@ep-xxxx-yyyy-zzz.us-east-2.aws.neon.tech/exampass?sslmode=require
#
# Solo copia estos valores al .env; NO subas credenciales a git.

DB_HOST=ep-XXXX-YYYY-0000.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=exampass
DB_USER=usuario_de_neon
DB_PASSWORD=RellenaConLaContrasenaDeNeon
DB_SSLMODE=require No newline at end of file