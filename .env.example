# Base de datos PostgreSQL en la nube (Neon) - compartida por el equipo
DB_HOST=ep-xxxx-yyyy-pooler.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=cambia-esta-contrasena
DB_SSLMODE=require

# Brevo / correo (API key para el envío de correos)
BREVO_API_KEY=

# Secreto para firmar los tokens JWT
JWT_SECRET=cambia-este-secreto

# Puertos publicados por Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=80

# Orígenes permitidos por CORS en el backend (separados por coma).
# En local se permite cualquier puerto de localhost.
APP_CORS_ALLOWED_ORIGINS=http://localhost:*

# URL base de la API usada por el frontend en el build.
# Vacío => "/api" (mismo origen, ideal con nginx/Docker o en local).
# En Render (frontend Static Site) apuntar al backend, ej:
# VITE_API_URL=https://exampass-backend.onrender.com/api
VITE_API_URL=
