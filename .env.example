POSTGRES_PASSWORD=exampass
POSTGRES_PORT=5432

# Aplicación Spring Boot (solo se usan si se exportan como variables de entorno;
# por defecto la app usa los mismos valores: exampass/exampass en localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exampass
DB_USER=exampass
DB_PASSWORD=exampass